{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation impact V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "documentation_impact": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "FEATURE",
                "CONTROLS",
                "TASKS",
                "DEPENDENCIES",
                "READINESS"
              ]
            }
          },
          "status_before": {
            "enum": [
              "UNIMPLEMENTED",
              "BROKEN",
              "PROXY_ONLY",
              "PARTIAL",
              "FUNCTIONAL",
              "PRO_READY",
              "PRODUCTION_READY"
            ]
          },
          "status_after": {
            "enum": [
              "UNIMPLEMENTED",
              "BROKEN",
              "PROXY_ONLY",
              "PARTIAL",
              "FUNCTIONAL",
              "PRO_READY",
              "PRODUCTION_READY"
            ]
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2400
          }
        },
        "required": [
          "feature_id",
          "documentation_impact",
          "status_before",
          "status_after",
          "source_paths",
          "reason"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "changes"
  ]
}
