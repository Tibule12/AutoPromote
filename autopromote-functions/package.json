{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint --ext .js index.js lib --max-warnings=0",
    "format": "prettier --write \"**/*.{js,json}\"",
    "format:check": "prettier --check \"**/*.{js,json}\"",
    "postinstall": "node security-dependency-guards.js && node copy-server.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "validate:imports": "node validate-imports.js",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "index.js",
  "dependencies": {
    "@sentry/node": "^7.72.0",
    "autopromote-server": "file:..",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.1",
    "express-rate-limit": "^6.8.0",
    "fast-xml-parser": "5.8.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.5.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.6",
    "googleapis": "^132.0.0",
    "helmet": "^6.0.1",
    "joi": "^18.2.5",
    "multer": "^2.3.0",
    "node-fetch": "^2.7.0",
    "streamifier": "^0.1.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "websocket-driver": "0.7.5",
    "hono": "4.13.11",
    "@hono/node-server": "^1.19.14",
    "protobufjs": "7.6.5",
    "form-data": "$form-data",
    "basic-ftp": "6.2.3",
    "follow-redirects": "^1.16.1",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "@humanfs/node": "0.16.8",
    "ts-deepmerge": "8.0.0",
    "@babel/core": "7.29.7",
    "glob": "^11.1.0",
    "minimatch": "^10.2.3",
    "node-forge": "1.4.0",
    "@tootallnate/once": "3.0.1",
    "@grpc/grpc-js": "1.14.5",
    "flatted": "3.4.2",
    "fast-uri": "3.1.8",
    "qs": "6.16.0",
    "uuid": "^14.0.0",
    "ws": "8.21.0",
    "lodash": "^4.18.1",
    "router": {
      "path-to-regexp": "8.4.0"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "jest-util": {
      "picomatch": "4.0.4"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@6": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "compression": "$compression",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "launch-editor": "2.14.2",
    "@fastify/busboy": "3.2.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "ip-address": "10.7.1",
    "re2": "1.26.1"
  },
  "private": true
}
