{"deadlineEpoch":1791536400,"id":"broll-plan-9239d3aadc6e6e00b789430d","input":{"context":[{"id":"transcript-caption-0-timeline-1","start":1.22,"end":4.26,"text":"Hello, my lovely viewers at home.","reviewRequired":false},{"id":"transcript-caption-1-timeline-1","start":4.26,"end":5.98,"text":"It has truly been a long time.","reviewRequired":false},{"id":"transcript-caption-2-timeline-1","start":5.98,"end":7.54,"text":"I have missed you so much,","reviewRequired":false},{"id":"transcript-caption-3-cue-1-timeline-1","start":7.54,"end":9.6925,"text":"and I hope you missed us as","reviewRequired":false},{"id":"transcript-caption-3-cue-2-timeline-1","start":9.6925,"end":10,"text":"well.","reviewRequired":false},{"id":"transcript-caption-4-cue-1-timeline-1","start":10,"end":12.411111111111111,"text":"I am thrilled to tell you we","reviewRequired":false},{"id":"transcript-caption-4-cue-2-timeline-1","start":12.411111111111111,"end":13.1,"text":"are back.","reviewRequired":false},{"id":"transcript-caption-5-timeline-1","start":13.1,"end":15.54,"text":"We are back, like we never left.","reviewRequired":false},{"id":"transcript-caption-6-timeline-1","start":15.54,"end":18.4,"text":"I welcome you to another episode","reviewRequired":false},{"id":"transcript-caption-7-timeline-1","start":18.4,"end":21.14,"text":"of Unmuted Podcast.","reviewRequired":false},{"id":"transcript-caption-8-timeline-1","start":21.14,"end":22.8,"text":"Every week, we will","reviewRequired":false},{"id":"transcript-caption-9-timeline-1","start":22.8,"end":24.82,"text":"dive into deep, raw","reviewRequired":false},{"id":"transcript-caption-10-timeline-1","start":24.82,"end":27.5,"text":"and authentic conversations","reviewRequired":false},{"id":"transcript-caption-11-timeline-1","start":27.5,"end":29.82,"text":"with community arts leaders and members.","reviewRequired":false},{"id":"transcript-caption-12-timeline-1","start":29.82,"end":32.42,"text":"Uncovering their untold stories,","reviewRequired":false},{"id":"transcript-caption-13-timeline-1","start":32.42,"end":35.14,"text":"layer by layer, truth by truth.","reviewRequired":false},{"id":"transcript-caption-14-timeline-1","start":35.14,"end":37.5,"text":"Are you ready? Fasten your seatbelts.","reviewRequired":false},{"id":"transcript-caption-15-timeline-1","start":37.5,"end":40.65,"text":"I am your host.","reviewRequired":false},{"id":"transcript-caption-16-timeline-1","start":40.65,"end":43.98,"text":"Today is truly a special one,","reviewRequired":false},{"id":"transcript-caption-17-cue-1-timeline-1","start":43.98,"end":46.4825,"text":"I am sitting across from a sensational","reviewRequired":false},{"id":"transcript-caption-17-cue-2-timeline-1","start":46.4825,"end":46.84,"text":"guest.","reviewRequired":false},{"id":"transcript-caption-18-timeline-1","start":46.84,"end":49.08,"text":"Welcome to our studio.","reviewRequired":false},{"id":"transcript-caption-19-timeline-1","start":49.08,"end":53.18,"text":"Thank you. My name is Siphamandla.","reviewRequired":false},{"id":"transcript-caption-20-cue-1-timeline-1","start":53.18,"end":55.03,"text":"I live in Harare, Khayelitsha.","reviewRequired":false},{"id":"transcript-caption-20-cue-2-timeline-1","start":55.03,"end":57.25,"text":"I am happy to be here.","reviewRequired":false},{"id":"transcript-caption-21-timeline-1","start":57.25,"end":59.72,"text":"First and foremost, thank you so much.","reviewRequired":false},{"id":"transcript-caption-22-timeline-1","start":59.72,"end":61.76,"text":"thank you for accepting our invitation.","reviewRequired":false},{"id":"transcript-caption-23-timeline-1","start":61.76,"end":63.98,"text":"It means a lot to us.","reviewRequired":false},{"id":"transcript-caption-24-timeline-1","start":63.98,"end":66.9,"text":"Let us get into it.","reviewRequired":false},{"id":"transcript-caption-25-timeline-1","start":66.9,"end":69.42,"text":"I want you to take us back.","reviewRequired":false},{"id":"transcript-caption-26-timeline-1","start":6