      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-12",
      "start": 29.82,
      "end": 32.42,
      "text": "Uncovering their untold stories,",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-13",
      "start": 32.42,
      "end": 35.14,
      "text": "layer by layer, truth by truth.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-14",
      "start": 35.14,
      "end": 37.5,
      "text": "Are you ready? Fasten your seatbelts.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-15",
      "start": 37.5,
      "end": 40.65,
      "text": "I am your host.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-16",
      "start": 40.65,
      "end": 43.98,
      "text": "Today is truly a special one,",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-17-cue-1",
      "start": 43.98,
      "end": 46.4825,
      "text": "I am sitting across from a sensational",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-17-cue-2",
      "start": 46.4825,
      "end": 46.84,
      "text": "guest.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-18",
      "start": 46.84,
      "end": 49.08,
      "text": "Welcome to our studio.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-19",
      "start": 49.08,
      "end": 53.18,
      "text": "Thank you. My name is Siphamandla.",
      "speaker": "guest",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-20-cue-1",
      "start": 53.18,
      "end": 55.03,
      "text": "I live in Harare, Khayelitsha.",
      "speaker": "guest",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-20-cue-2",
      "start": 55.03,
      "end": 57.25,
      "text": "I am happy to be here.",
      "speaker": "guest",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-21",
      "start": 57.25,
      "end": 59.72,
      "text": "First and foremost, thank you so much.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-22",
      "start": 59.72,
      "end": 61.76,
      "text": "thank you for accepting our invitation.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-23",
      "start": 61.76,
      "end": 63.98,
      "text": "It means a lot to us.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-24",
      "start": 63.98,
      "end": 66.9,
      "text": "Let us get into it.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-25",
      "start": 66.9,
      "end": 69.42,
      "text": "I want you to take us back.",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-26",
      "start": 69.42,
      "end": 71.5,
      "text": "Many people know you as a comedian,",
      "speaker": "host",
      "language": "en",
      "reviewRequired": false,
      "textReviewed": true
    },
    {
      "id": "transcript-caption-27",
