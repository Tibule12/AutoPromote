  "captions": [
    {
      "id": "transcript-caption-0",
      "text": "Hello, my lovely viewers at home.",
      "start": 1.22,
      "end": 4.26,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-1",
      "text": "It has truly been a long time.",
      "start": 4.26,
      "end": 5.98,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-2",
      "text": "I have missed you so much,",
      "start": 5.98,
      "end": 7.54,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-3-cue-1",
      "text": "and I hope you missed us as",
      "start": 7.54,
      "end": 9.6925,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-3-cue-2",
      "text": "well.",
      "start": 9.6925,
      "end": 10,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-4-cue-1",
      "text": "I am thrilled to tell you we",
      "start": 10,
      "end": 12.411111111111111,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-4-cue-2",
      "text": "are back.",
      "start": 12.411111111111111,
      "end": 13.1,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-5",
      "text": "We are back, like we never left.",
      "start": 13.1,
      "end": 15.54,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-6",
      "text": "I welcome you to another episode",
      "start": 15.54,
      "end": 18.4,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-7",
      "text": "of Unmuted Podcast.",
      "start": 18.4,
      "end": 21.14,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-8",
      "text": "Every week, we will",
      "start": 21.14,
      "end": 22.8,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-9",
      "text": "dive into deep, raw",
      "start": 22.8,
      "end": 24.82,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-10",
      "text": "and authentic conversations",
      "start": 24.82,
      "end": 27.5,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-11",
      "text": "with community arts leaders and members.",
      "start": 27.5,
      "end": 29.82,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-12",
      "text": "Uncovering their untold stories,",
      "start": 29.82,
      "end": 32.42,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-13",
      "text": "layer by layer, truth by truth.",
      "start": 32.42,
      "end": 35.14,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-14",
      "text": "Are you ready? Fasten your seatbelts.",
      "start": 35.14,
      "end": 37.5,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-15",
      "text": "I am your host.",
      "start": 37.5,
      "end": 40.65,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-16",
      "text": "Today is truly a special one,",
      "start": 40.65,
      "end": 43.98,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-17-cue-1",
      "text": "I am sitting across from a sensational",
      "start": 43.98,
      "end": 46.4825,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-17-cue-2",
      "text": "guest.",
      "start": 46.4825,
      "end": 46.84,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-18",
      "text": "Welcome to our studio.",
      "start": 46.84,
      "end": 49.08,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-19",
      "text": "Thank you. My name is Siphamandla.",
      "start": 49.08,
      "end": 53.18,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-20-cue-1",
      "text": "I live in Harare, Khayelitsha.",
      "start": 53.18,
      "end": 55.03,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-20-cue-2",
      "text": "I am happy to be here.",
      "start": 55.03,
      "end": 57.25,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-21",
      "text": "First and foremost, thank you so much.",
      "start": 57.25,
      "end": 59.72,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-22",
      "text": "thank you for accepting our invitation.",
      "start": 59.72,
      "end": 61.76,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-23",
      "text": "It means a lot to us.",
      "start": 61.76,
      "end": 63.98,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-24",
      "text": "Let us get into it.",
      "start": 63.98,
      "end": 66.9,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-25",
      "text": "I want you to take us back.",
      "start": 66.9,
      "end": 69.42,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-26",
      "text": "Many people know you as a comedian,",
      "start": 69.42,
      "end": 71.5,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-27",
      "text": "someone who always makes us laugh.",
      "start": 71.5,
      "end": 76.4,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-28",
      "text": "I want us to go deeper.",
      "start": 76.4,
      "end": 78.2,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-29",
      "text": "Can you please tell us",
      "start": 78.2,
      "end": 80.08,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-30",
      "text": "where you were born and raised?",
      "start": 80.08,
      "end": 83.12,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-31",
      "text": "What was your childhood like?",
      "start": 83.12,
      "end": 86.04,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-32",
      "text": "I was born here in Cape Town.",
      "start": 86.04,
      "end": 88.6,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-33-cue-1",
      "text": "Then I moved to Durban at two",
      "start": 90.22,
      "end": 92.91111111111111,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-33-cue-2",
      "text": "months old,",
      "start": 92.91111111111111,
      "end": 93.68,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-34",
      "text": "with my grandmother.",
      "start": 93.68,
      "end": 96.4,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-35",
      "text": "I was a church-going child.",
      "start": 96.4,
      "end": 99.78,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-36",
      "text": "I loved my friends and playing,",
      "start": 99.78,
      "end": 102.72,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-37",
      "text": "like every other child.",
      "start": 102.72,
      "end": 106.26,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-38-cue-1",
      "text": "I grew up well.",
      "start": 106.26,
      "end": 107.84,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-38-cue-2",
      "text": "Everything was going well.",
      "start": 107.84,
      "end": 109.42,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-39",
      "text": "I love that!",
      "start": 109.42,
      "end": 112.82,
      "language": "en",
      "speaker": "guest",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-40-cue-1",
      "text": "You are a singer — a great",
      "start": 112.82,
      "end": 115.3225,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-40-cue-2",
      "text": "one!",
      "start": 115.3225,
      "end": 115.68,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-41",
      "text": "On that note,",
      "start": 115.68,
      "end": 117.32,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-42",
      "text": "I want you",
      "start": 117.32,
      "end": 118.58,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    },
    {
      "id": "transcript-caption-43",
      "text": "to take us back…",
      "start": 118.58,
      "end": 120,
      "language": "en",
      "speaker": "host",
      "reviewRequired": false
    }
  ],
