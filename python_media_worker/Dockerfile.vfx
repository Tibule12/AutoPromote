# Optional offline inference/compositor runtime. The CPU worker stays lightweight.
# Later Blackwell preparation: CUDA_BASE=12.8 cuDNN base + TORCH_INDEX_URL=cu128.
ARG CUDA_BASE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
FROM ${CUDA_BASE}
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ffmpeg fonts-dejavu-core libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/vfx
ENV PATH=/opt/vfx/bin:$PATH NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 --index-url ${TORCH_INDEX_URL} \
    && pip install --no-cache-dir transformers==4.56.2 accelerate==1.10.1 \
       numpy==1.26.4 Pillow==11.3.0 opencv-python-headless==4.11.0.86 lm-format-enforcer==0.11.3 \
       fastapi==0.116.1 uvicorn==0.35.0 requests==2.32.5
WORKDIR /app
COPY studio_subject_matte.py studio_vfx_plan.py ./
COPY studio_subject_vfx_job.py studio_subject_vfx_server.py ./
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
CMD ["python3", "studio_subject_matte.py", "--help"]
