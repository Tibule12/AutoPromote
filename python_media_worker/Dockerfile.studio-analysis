FROM python:3.10-slim-bookworm

ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.studio-analysis.txt ./
RUN pip install --no-cache-dir -r requirements.studio-analysis.txt

COPY studio_face_tracking.py studio_analysis_analyzer.py ./
COPY models/yunet/face_detection_yunet_2023mar.onnx models/yunet/face_detection_yunet_2023mar.onnx

RUN useradd -r -u 10001 studio
USER studio
CMD ["sh", "-c", "uvicorn studio_analysis_analyzer:app --host 0.0.0.0 --port ${PORT}"]
