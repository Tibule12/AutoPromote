{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "--build-arg",
        "MEDIA_WORKER_BASE_IMAGE=${_BASE_IMAGE}",
        "-f",
        "Dockerfile.gpu-backup",
        "-t",
        "${_GPU_IMAGE}",
        "."
      ]
    }
  ],
  "images": [
    "${_GPU_IMAGE}"
  ],
  "timeout": "2400s",
  "options": {
    "machineType": "E2_HIGHCPU_8"
  }
}
